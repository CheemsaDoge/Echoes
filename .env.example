# Use scripts/bootstrap_env.py; do not use these placeholders as secrets.
API_TOKEN=REPLACE_WITH_RANDOM_API_TOKEN
MCP_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_MCP_TOKEN
DATA_DIR=./data
ECHOLEDGER_DB_PATH=./data/echoledger.sqlite3
ECHOLEDGER_STORAGE_DIR=./data/recordings
ECHOLEDGER_VOICEPRINT_ONNX_PATH=./data/models/speakers/wespeaker_zh_cnceleb_resnet34.onnx

# ASR Provider: vertexai | gemini | mock | disabled
ASR_PROVIDER=vertexai

# Google Cloud Vertex AI Configuration
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_API_KEY=

# Gemini AI Studio Configuration (Alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-transcribe
GEMINI_MODE=transcribe

# VAD & Speaker Configuration
VAD_PROVIDER=silero_v5
VAD_MODEL_PATH=./data/models/silero_vad.onnx
SPEAKER_MODEL_ID=wespeaker_ecapa_tdnn512

RUN_WORKER=true
ALLOWED_ORIGINS=
