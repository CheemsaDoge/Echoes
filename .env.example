# Use scripts/bootstrap_env.py; do not use these placeholders as secrets.
API_TOKEN=REPLACE_WITH_RANDOM_API_TOKEN
MCP_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_MCP_TOKEN
DATA_DIR=./data

# ASR Provider: vertexai | gemini | mock | disabled
ASR_PROVIDER=vertexai

# Google Cloud Vertex AI Configuration
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_API_KEY=

# Gemini AI Studio Configuration (Alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-transcribe
GEMINI_MODE=transcribe

# VAD Configuration
VAD_PROVIDER=passthrough
VAD_MODEL_PATH=

RUN_WORKER=true
ALLOWED_ORIGINS=
